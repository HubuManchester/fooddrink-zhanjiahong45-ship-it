<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.AddItemPage"
             Title="Add Record">
    <ScrollView>
        <ScrollView.Background>
            <StaticResource Key="PageBackgroundBrush" />
        </ScrollView.Background>
        <VerticalStackLayout Padding="{OnIdiom Phone='20,18,20,24', Tablet='34,26,34,30', Desktop='42,28,42,34'}" Spacing="16">
            <Border Style="{StaticResource HeroCard}">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                    <Label x:Name="FormTitleLabel"
                           Text="Add food or drink"
                           Style="{StaticResource Display1}"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label x:Name="FormSubtitleLabel"
                           Grid.Row="1"
                           Text="Record the full details of a meal worth remembering."
                           Style="{StaticResource BodyText}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource GlassCard}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Basic Information"
                           Style="{StaticResource TitleText}"
                           TextColor="{AppThemeBinding Light={StaticResource AccentTextL}, Dark={StaticResource AccentA}}"
                           SemanticProperties.HeadingLevel="Level2" />
                    <Entry x:Name="NameEntry"
                           Placeholder="Name"
                           SemanticProperties.Description="Food or drink name"
                           SemanticProperties.Hint="Required food or drink name" />
                    <Picker x:Name="CategoryPicker"
                            Title="Category"
                            SemanticProperties.Description="Meal category"
                            SemanticProperties.Hint="Required category">
                        <Picker.Items>
                            <x:String>Breakfast</x:String>
                            <x:String>Lunch</x:String>
                            <x:String>Dinner</x:String>
                            <x:String>Snack</x:String>
                            <x:String>Drink</x:String>
                        </Picker.Items>
                    </Picker>
                    <Editor x:Name="DescriptionEditor"
                            Placeholder="Description, ingredients, flavour, or context"
                            AutoSize="TextChanges"
                            HeightRequest="104"
                            SemanticProperties.Description="Food or drink description"
                            SemanticProperties.Hint="Describe this food or drink" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource GlassCard}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Nutrition Data"
                           Style="{StaticResource TitleText}"
                           TextColor="{AppThemeBinding Light={StaticResource AccentFreshL}, Dark={StaticResource AccentFresh}}"
                           SemanticProperties.HeadingLevel="Level2" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Entry x:Name="CaloriesEntry"
                               Placeholder="Calories"
                               FontFamily="Mono"
                               Keyboard="Numeric"
                               SemanticProperties.Description="Calories"
                               SemanticProperties.Hint="Required calories as a number" />
                        <Entry x:Name="ProteinEntry"
                               Grid.Column="1"
                               Placeholder="Protein g"
                               FontFamily="Mono"
                               Keyboard="Numeric"
                               SemanticProperties.Description="Protein grams"
                               SemanticProperties.Hint="Enter protein grams as a number" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Entry x:Name="CarbsEntry"
                               Placeholder="Carbs g"
                               FontFamily="Mono"
                               Keyboard="Numeric"
                               SemanticProperties.Description="Carbohydrate grams"
                               SemanticProperties.Hint="Enter carbohydrate grams as a number" />
                        <Entry x:Name="FatEntry"
                               Grid.Column="1"
                               Placeholder="Fat g"
                               FontFamily="Mono"
                               Keyboard="Numeric"
                               SemanticProperties.Description="Fat grams"
                               SemanticProperties.Hint="Enter fat grams as a number" />
                    </Grid>
                    <Entry x:Name="AllergyEntry"
                           Placeholder="Allergy note or dietary restriction"
                           SemanticProperties.Description="Allergy or dietary note"
                           SemanticProperties.Hint="Enter allergy or dietary information" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="ValidationPanel"
                    IsVisible="False"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource WarningTextL}, Dark={StaticResource WarningText}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource WarningFillL}, Dark={StaticResource WarningFill}}"
                    Padding="14">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Label x:Name="ValidationLabel"
                       TextColor="{AppThemeBinding Light={StaticResource WarningTextL}, Dark={StaticResource WarningText}}"
                       FontAttributes="Bold"
                       SemanticProperties.Description="Validation message" />
            </Border>

            <Button x:Name="SaveButton"
                    Text="Save record"
                    FontAttributes="Bold"
                    Clicked="OnSaveClicked"
                    SemanticProperties.Description="Save record"
                    SemanticProperties.Hint="Validate and save this record" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
