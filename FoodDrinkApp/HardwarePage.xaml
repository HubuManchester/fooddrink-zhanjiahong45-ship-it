<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.HardwarePage"
             Title="Hardware Demo">
    <ScrollView>
        <ScrollView.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{AppThemeBinding Light=#FFF1DA, Dark=#130F0C}" Offset="0.0" />
                <GradientStop Color="{AppThemeBinding Light=#FFF9EF, Dark=#0F1711}" Offset="1.0" />
            </LinearGradientBrush>
        </ScrollView.Background>

        <VerticalStackLayout Padding="22" Spacing="16">
            <Border StrokeThickness="0" Padding="18" BackgroundColor="{AppThemeBinding Light=#FFFDF8, Dark=#1A1712}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Mobile hardware"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#3A2518, Dark=#FFF2DF}"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="Demonstrate camera, location, speech, vibration, and haptic feedback."
                           FontSize="15"
                           TextColor="{AppThemeBinding Light=#8B6D55, Dark=#D8C4AC}" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#F0D6B8, Dark=#3E3023}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFA, Dark=#1A1712}"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Food photo" FontSize="17" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#D9472B, Dark=#FF9C7B}" />
                            <Label Text="Capture the colour and condition of the meal." FontSize="13" TextColor="{AppThemeBinding Light=#8B6D55, Dark=#D8C4AC}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="Photo"
                                BackgroundColor="#D9472B"
                                TextColor="#FFFFFF"
                                Clicked="OnTakePhotoClicked"
                                SemanticProperties.Hint="Open the camera to capture a food image" />
                    </Grid>
                    <Border StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light=#FFF0C9, Dark=#312316}"
                            HeightRequest="220">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Image x:Name="FoodPhoto"
                               Aspect="AspectFill"
                               SemanticProperties.Description="Captured food photo preview" />
                    </Border>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label x:Name="PredictionLabel"
                               Text="Food recognition result will appear here."
                               FontSize="13"
                               TextColor="{AppThemeBinding Light=#6E5A47, Dark=#D8C4AC}"
                               VerticalOptions="Center"
                               SemanticProperties.Description="Latest food recognition result" />
                        <Button x:Name="ReadPredictionButton"
                                Grid.Column="1"
                                Text="Read"
                                IsEnabled="False"
                                Clicked="OnReadPredictionClicked"
                                SemanticProperties.Hint="Read the latest food recognition result aloud" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#F0D6B8, Dark=#3E3023}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFA, Dark=#1A1712}"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Meal location" FontSize="17" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#2F7A4F, Dark=#8CE6A1}" />
                            <Label Text="Show country, city, region, and coordinates." FontSize="13" TextColor="{AppThemeBinding Light=#8B6D55, Dark=#D8C4AC}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="Locate"
                                BackgroundColor="#2F7A4F"
                                TextColor="#FFFFFF"
                                Clicked="OnGetLocationClicked"
                                SemanticProperties.Hint="Use location to record the meal place" />
                    </Grid>
                    <Label x:Name="LocationLabel"
                           Grid.Row="1"
                           Text="Location has not been captured yet."
                           FontSize="15"
                           TextColor="{AppThemeBinding Light=#6E5A47, Dark=#D8C4AC}" />
                    <Label x:Name="CoordinateLabel"
                           Grid.Row="2"
                           Text="Coordinates will appear here."
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#9A7B63, Dark=#BFA58E}" />
                </Grid>
            </Border>

            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#F0D6B8, Dark=#3E3023}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFA, Dark=#1A1712}"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Live sensors"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#D9472B, Dark=#FF9C7B}"
                               SemanticProperties.HeadingLevel="Level2" />
                        <Label Text="Start each sensor, then move the emulator sliders or the device."
                               FontSize="13"
                               TextColor="{AppThemeBinding Light=#8B6D55, Dark=#D8C4AC}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="5" ColumnSpacing="12">
                        <Label Text="Accelerometer"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#3A2518, Dark=#FFF2DF}" />
                        <Button x:Name="AccelerometerButton"
                                Grid.Column="1"
                                Text="Start"
                                Clicked="OnToggleAccelerometerClicked"
                                SemanticProperties.Description="Start or stop accelerometer readings"
                                SemanticProperties.Hint="Tilt the device to update the acceleration values" />
                        <Label x:Name="AccelLabel"
                               Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Text="Acceleration values will appear here."
                               FontSize="13"
                               TextColor="{AppThemeBinding Light=#6E5A47, Dark=#D8C4AC}"
                               SemanticProperties.Description="Live accelerometer reading" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F0D6B8, Dark=#3E3023}" />

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="5" ColumnSpacing="12">
                        <Label Text="Compass"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#3A2518, Dark=#FFF2DF}" />
                        <Button x:Name="CompassButton"
                                Grid.Column="1"
                                Text="Start"
                                Clicked="OnToggleCompassClicked"
                                SemanticProperties.Description="Start or stop compass readings"
                                SemanticProperties.Hint="Rotate the device to update the heading" />
                        <Label x:Name="CompassLabel"
                               Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Text="Compass heading will appear here."
                               FontSize="13"
                               TextColor="{AppThemeBinding Light=#6E5A47, Dark=#D8C4AC}"
                               SemanticProperties.Description="Live compass heading" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F0D6B8, Dark=#3E3023}" />

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="5" ColumnSpacing="12">
                        <Label Text="Gyroscope"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#3A2518, Dark=#FFF2DF}" />
                        <Button x:Name="GyroscopeButton"
                                Grid.Column="1"
                                Text="Start"
                                Clicked="OnToggleGyroscopeClicked"
                                SemanticProperties.Description="Start or stop gyroscope readings"
                                SemanticProperties.Hint="Rotate the device to update angular velocity values" />
                        <Label x:Name="GyroLabel"
                               Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Text="Gyroscope values will appear here."
                               FontSize="13"
                               TextColor="{AppThemeBinding Light=#6E5A47, Dark=#D8C4AC}"
                               SemanticProperties.Description="Live gyroscope reading" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#F0D6B8, Dark=#3E3023}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFA, Dark=#1A1712}"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Flashlight and shake"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#2F7A4F, Dark=#8CE6A1}"
                                   SemanticProperties.HeadingLevel="Level2" />
                            <Label Text="Implemented in code (not the camera's built-in flash)."
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#8B6D55, Dark=#D8C4AC}" />
                        </VerticalStackLayout>
                        <Button x:Name="FlashlightButton"
                                Grid.Column="1"
                                Text="Flash"
                                BackgroundColor="#2F7A4F"
                                TextColor="#FFFFFF"
                                Clicked="OnToggleFlashlightClicked"
                                SemanticProperties.Description="Turn the device flashlight on or off"
                                SemanticProperties.Hint="Requires a real device with a flashlight" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="5" ColumnSpacing="12">
                        <Label Text="Shake-to-suggest"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#3A2518, Dark=#FFF2DF}" />
                        <Button x:Name="ShakeButton"
                                Grid.Column="1"
                                Text="Enable"
                                Clicked="OnToggleShakeSuggestionClicked"
                                SemanticProperties.Description="Enable or disable shake meal suggestions"
                                SemanticProperties.Hint="Shake the device to choose a random meal suggestion" />
                        <Label x:Name="ShakeSuggestionLabel"
                               Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Text="Enable shake suggestions, then shake the device."
                               FontSize="13"
                               TextColor="{AppThemeBinding Light=#6E5A47, Dark=#D8C4AC}"
                               SemanticProperties.Description="Latest shake meal suggestion" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="Read help"
                        BackgroundColor="#F29B38"
                        TextColor="#3A2518"
                        Clicked="OnReadHelpClicked"
                        SemanticProperties.Hint="Read the help text aloud" />
                <Button Grid.Column="1"
                        Text="Stop speech"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFA, Dark=#1A1712}"
                        BorderColor="{AppThemeBinding Light=#F0D6B8, Dark=#3E3023}"
                        BorderWidth="1"
                        TextColor="{AppThemeBinding Light=#D9472B, Dark=#FFB15D}"
                        Clicked="OnStopSpeechClicked"
                        SemanticProperties.Hint="Stop current speech" />
            </Grid>

            <Button Text="Haptic feedback"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFA, Dark=#1A1712}"
                    BorderColor="{AppThemeBinding Light=#F0D6B8, Dark=#3E3023}"
                    BorderWidth="1"
                    TextColor="{AppThemeBinding Light=#D9472B, Dark=#FFB15D}"
                    Clicked="OnFeedbackClicked"
                    SemanticProperties.Hint="Trigger vibration and haptic feedback" />

            <Border StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#FFF0C9, Dark=#312316}"
                    Padding="14">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="HardwareStatusLabel"
                           Text="Ready."
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#A95517, Dark=#FFD18E}" />
                    <Label x:Name="FeedbackCountLabel"
                           Text="Haptic feedback tests: 0"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#6E5A47, Dark=#D8C4AC}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
