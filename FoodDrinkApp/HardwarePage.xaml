<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.HardwarePage"
             Title="Hardware Demo">
    <ScrollView>
        <ScrollView.Background>
            <StaticResource Key="PageBackgroundBrush" />
        </ScrollView.Background>

        <VerticalStackLayout Padding="{OnIdiom Phone='20,18,20,24', Tablet='34,26,34,30', Desktop='42,28,42,34'}" Spacing="16">
            <Border Style="{StaticResource HeroCard}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Mobile hardware"
                           Style="{StaticResource Display1}"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="Demonstrate camera, location, speech, vibration, and haptic feedback."
                           Style="{StaticResource BodyText}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource GlassCard}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Food Photo" Style="{StaticResource TitleText}" TextColor="{AppThemeBinding Light={StaticResource AccentTextL}, Dark={StaticResource AccentA}}" />
                            <Label Text="Capture the colour and condition of the meal." Style="{StaticResource CaptionText}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="Photo"
                                Clicked="OnTakePhotoClicked"
                                SemanticProperties.Description="Capture food photo"
                                SemanticProperties.Hint="Open the camera to capture a food image" />
                    </Grid>
                    <Border StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Surface2L}, Dark={StaticResource Surface2}}"
                            HeightRequest="220">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Image x:Name="FoodPhoto"
                               Aspect="AspectFill"
                               SemanticProperties.Description="Captured food photo preview" />
                    </Border>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label x:Name="PredictionLabel"
                               Text="Food recognition result will appear here."
                               Style="{StaticResource TelemetryText}"
                               VerticalOptions="Center"
                               SemanticProperties.Description="Latest food recognition result" />
                        <Button x:Name="ReadPredictionButton"
                                Grid.Column="1"
                                Text="Read"
                                IsEnabled="False"
                                Clicked="OnReadPredictionClicked"
                                SemanticProperties.Description="Read food recognition result"
                                SemanticProperties.Hint="Read the latest food recognition result aloud" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource GlassCard}">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Meal Location" Style="{StaticResource TitleText}" TextColor="{AppThemeBinding Light={StaticResource AccentFreshL}, Dark={StaticResource AccentFresh}}" />
                            <Label Text="Show country, city, region, and coordinates." Style="{StaticResource CaptionText}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="Locate"
                                Background="{StaticResource FreshBrush}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimaryL}, Dark={StaticResource BgBase}}"
                                Clicked="OnGetLocationClicked"
                                SemanticProperties.Description="Locate meal"
                                SemanticProperties.Hint="Use location to record the meal place" />
                    </Grid>
                    <Label x:Name="LocationLabel"
                           Grid.Row="1"
                           Text="Location has not been captured yet."
                           Style="{StaticResource BodyText}"
                           SemanticProperties.Description="Meal location" />
                    <Label x:Name="CoordinateLabel"
                           Grid.Row="2"
                           Text="Coordinates will appear here."
                           Style="{StaticResource TelemetryText}"
                           SemanticProperties.Description="Meal coordinates" />
                </Grid>
            </Border>

            <Border Style="{StaticResource GlassCard}">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Live Sensors"
                               Style="{StaticResource TitleText}"
                               TextColor="{AppThemeBinding Light={StaticResource AccentTextL}, Dark={StaticResource AccentA}}"
                               SemanticProperties.HeadingLevel="Level2" />
                        <Label Text="Start each sensor, then move the emulator sliders or the device."
                               Style="{StaticResource CaptionText}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="5" ColumnSpacing="12">
                        <Label Text="Accelerometer"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryL}, Dark={StaticResource TextPrimary}}" />
                        <Button x:Name="AccelerometerButton"
                                Grid.Column="1"
                                Text="Start"
                                Clicked="OnToggleAccelerometerClicked"
                                SemanticProperties.Description="Start or stop accelerometer readings"
                                SemanticProperties.Hint="Tilt the device to update the acceleration values" />
                        <Label x:Name="AccelLabel"
                               Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Text="Acceleration values will appear here."
                               Style="{StaticResource TelemetryText}"
                               SemanticProperties.Description="Live accelerometer reading" />
                    </Grid>

                    <BoxView HeightRequest="1" />

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="5" ColumnSpacing="12">
                        <Label Text="Compass"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryL}, Dark={StaticResource TextPrimary}}" />
                        <Button x:Name="CompassButton"
                                Grid.Column="1"
                                Text="Start"
                                Clicked="OnToggleCompassClicked"
                                SemanticProperties.Description="Start or stop compass readings"
                                SemanticProperties.Hint="Rotate the device to update the heading" />
                        <Label x:Name="CompassLabel"
                               Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Text="Compass heading will appear here."
                               Style="{StaticResource TelemetryText}"
                               SemanticProperties.Description="Live compass heading" />
                    </Grid>

                    <BoxView HeightRequest="1" />

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="5" ColumnSpacing="12">
                        <Label Text="Gyroscope"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryL}, Dark={StaticResource TextPrimary}}" />
                        <Button x:Name="GyroscopeButton"
                                Grid.Column="1"
                                Text="Start"
                                Clicked="OnToggleGyroscopeClicked"
                                SemanticProperties.Description="Start or stop gyroscope readings"
                                SemanticProperties.Hint="Rotate the device to update angular velocity values" />
                        <Label x:Name="GyroLabel"
                               Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Text="Gyroscope values will appear here."
                               Style="{StaticResource TelemetryText}"
                               SemanticProperties.Description="Live gyroscope reading" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource GlassCard}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Flashlight And Shake"
                                   Style="{StaticResource TitleText}"
                                   TextColor="{AppThemeBinding Light={StaticResource AccentFreshL}, Dark={StaticResource AccentFresh}}"
                                   SemanticProperties.HeadingLevel="Level2" />
                            <Label Text="Implemented in code (not the camera's built-in flash)."
                                   Style="{StaticResource CaptionText}" />
                        </VerticalStackLayout>
                        <Button x:Name="FlashlightButton"
                                Grid.Column="1"
                                Text="Flash"
                                Background="{StaticResource FreshBrush}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimaryL}, Dark={StaticResource BgBase}}"
                                Clicked="OnToggleFlashlightClicked"
                                SemanticProperties.Description="Turn the device flashlight on or off"
                                SemanticProperties.Hint="Requires a real device with a flashlight" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="5" ColumnSpacing="12">
                        <Label Text="Shake-to-suggest"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryL}, Dark={StaticResource TextPrimary}}" />
                        <Button x:Name="ShakeButton"
                                Grid.Column="1"
                                Text="Enable"
                                Clicked="OnToggleShakeSuggestionClicked"
                                SemanticProperties.Description="Enable or disable shake meal suggestions"
                                SemanticProperties.Hint="Shake the device to choose a random meal suggestion" />
                        <Label x:Name="ShakeSuggestionLabel"
                               Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Text="Enable shake suggestions, then shake the device."
                               Style="{StaticResource TelemetryText}"
                               SemanticProperties.Description="Latest shake meal suggestion" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="Read help"
                        Clicked="OnReadHelpClicked"
                        SemanticProperties.Description="Read hardware help"
                        SemanticProperties.Hint="Read the help text aloud" />
                <Button Grid.Column="1"
                        Text="Stop speech"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Surface1L}, Dark={StaticResource Surface2}}"
                        BorderColor="{AppThemeBinding Light={StaticResource HairlineL}, Dark={StaticResource Hairline}}"
                        BorderWidth="1"
                        TextColor="{AppThemeBinding Light={StaticResource AccentTextL}, Dark={StaticResource AccentB}}"
                        Clicked="OnStopSpeechClicked"
                        SemanticProperties.Description="Stop speech"
                        SemanticProperties.Hint="Stop current speech" />
            </Grid>

            <Button Text="Haptic feedback"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface1L}, Dark={StaticResource Surface2}}"
                    BorderColor="{AppThemeBinding Light={StaticResource HairlineL}, Dark={StaticResource Hairline}}"
                    BorderWidth="1"
                    TextColor="{AppThemeBinding Light={StaticResource AccentTextL}, Dark={StaticResource AccentB}}"
                    Clicked="OnFeedbackClicked"
                    SemanticProperties.Description="Haptic feedback"
                    SemanticProperties.Hint="Trigger vibration and haptic feedback" />

            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource HairlineL}, Dark={StaticResource Hairline}}"
                    BackgroundColor="{AppThemeBinding Light=#FFF2E7, Dark=#2C1A16}"
                    Padding="14">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="HardwareStatusLabel"
                           Text="Ready."
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource AccentTextL}, Dark={StaticResource AccentB}}"
                           SemanticProperties.Description="Hardware status" />
                    <Label x:Name="FeedbackCountLabel"
                           Text="Haptic feedback tests: 0"
                           Style="{StaticResource TelemetryText}"
                           SemanticProperties.Description="Haptic feedback test count" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
