<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.SettingsPage"
             Title="Settings">
    <ScrollView>
        <ScrollView.Background>
            <StaticResource Key="PageBackgroundBrush" />
        </ScrollView.Background>

        <VerticalStackLayout Padding="{OnIdiom Phone='20,18,20,24', Tablet='34,26,34,30', Desktop='42,28,42,34'}" Spacing="16">
            <Border Style="{StaticResource HeroCard}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Accessibility settings"
                           Style="{StaticResource Display1}"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="Large text takes effect immediately and remains active when switching pages."
                           Style="{StaticResource BodyText}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource GlassCard}">
                <VerticalStackLayout Spacing="16">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                        <Label Text="Theme mode"
                               Style="{StaticResource TitleText}"
                               TextColor="{AppThemeBinding Light={StaticResource AccentTextL}, Dark={StaticResource AccentA}}" />
                        <Picker x:Name="ThemePicker"
                                Grid.Row="1"
                                Title="Choose app theme"
                                SelectedIndexChanged="OnThemeChanged"
                                SemanticProperties.Hint="Switch between system, light, and dark theme">
                            <Picker.Items>
                                <x:String>Use system theme</x:String>
                                <x:String>Light theme</x:String>
                                <x:String>Dark theme</x:String>
                            </Picker.Items>
                        </Picker>
                    </Grid>

                    <BoxView HeightRequest="1" />

                    <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Text size"
                                   Style="{StaticResource TitleText}"
                                   TextColor="{AppThemeBinding Light={StaticResource AccentFreshL}, Dark={StaticResource AccentFresh}}" />
                            <Label Text="Scale text up to 200% for WCAG 1.4.4 verification."
                                   Style="{StaticResource CaptionText}" />
                        </VerticalStackLayout>
                        <Picker x:Name="TextScalePicker"
                                Grid.Row="1"
                                Title="Choose text size"
                                SelectedIndexChanged="OnTextScaleChanged"
                                SemanticProperties.Description="Text size"
                                SemanticProperties.Hint="Choose standard, large, extra large, or maximum text size">
                            <Picker.Items>
                                <x:String>Standard text</x:String>
                                <x:String>Large text 135%</x:String>
                                <x:String>Extra large text 175%</x:String>
                                <x:String>Maximum text 200%</x:String>
                            </Picker.Items>
                        </Picker>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource HairlineL}, Dark={StaticResource Hairline}}"
                    BackgroundColor="{AppThemeBinding Light=#FFF2E7, Dark=#2C1A16}"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="LargeTextPreviewTitle"
                           Text="Large text preview"
                           Style="{StaticResource TitleText}"
                           TextColor="{AppThemeBinding Light={StaticResource AccentTextL}, Dark={StaticResource AccentB}}" />
                    <Label x:Name="LargeTextPreviewBody"
                           Text="When enabled, this text and the rest of the page become visibly larger."
                           Style="{StaticResource BodyText}" />
                </VerticalStackLayout>
            </Border>

            <Label x:Name="SettingsStatusLabel"
                   Text="Settings ready."
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource AccentTextL}, Dark={StaticResource AccentB}}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
