<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.FoodDetailPage"
             Title="Nutrition Details">
    <ScrollView SemanticProperties.Hint="Swipe left or right to move between items.">
        <ScrollView.GestureRecognizers>
            <SwipeGestureRecognizer Direction="Left"
                                    Threshold="80"
                                    Swiped="OnDetailSwiped" />
            <SwipeGestureRecognizer Direction="Right"
                                    Threshold="80"
                                    Swiped="OnDetailSwiped" />
        </ScrollView.GestureRecognizers>
        <ScrollView.Background>
            <StaticResource Key="PageBackgroundBrush" />
        </ScrollView.Background>
        <VerticalStackLayout Padding="{OnIdiom Phone='20,18,20,24', Tablet='34,26,34,30', Desktop='42,28,42,34'}" Spacing="16">
            <Border x:Name="DetailHero"
                    Style="{StaticResource HeroCard}">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="12" ColumnSpacing="14">
                    <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label x:Name="NameLabel"
                               Style="{StaticResource Display1}"
                               SemanticProperties.HeadingLevel="Level1" />
                        <Label x:Name="CategoryLabel"
                               FontFamily="Mono"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource AccentTextL}, Dark={StaticResource AccentB}}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1"
                            Style="{StaticResource AccentChip}"
                            VerticalOptions="Start">
                        <Label Text="SCAN"
                               FontFamily="Mono"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource AccentFreshL}, Dark={StaticResource AccentFresh}}" />
                    </Border>
                    <Label Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Text="Macro telemetry and ingredient notes are rendered as a quick dashboard for the selected record."
                           Style="{StaticResource BodyText}" />
                </Grid>
            </Border>

            <Border x:Name="MacroCard"
                    Style="{StaticResource GlassCard}">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="{OnIdiom Phone='*', Tablet='210,*', Desktop='230,*'}" RowSpacing="16" ColumnSpacing="18">
                    <Grid HeightRequest="190" WidthRequest="190" HorizontalOptions="Center">
                        <GraphicsView x:Name="MacroRingView"
                                      HeightRequest="190"
                                      WidthRequest="190"
                                      SemanticProperties.Description="Animated macro ratio ring" />
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="Center">
                            <Label x:Name="CaloriesLabel"
                                   FontFamily="Mono"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource AccentTextL}, Dark={StaticResource AccentB}}"
                                   SemanticProperties.Description="Calories" />
                            <Label Text="ENERGY"
                                   FontFamily="Mono"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMutedL}, Dark={StaticResource TextMuted}}" />
                        </VerticalStackLayout>
                    </Grid>
                    <VerticalStackLayout Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                                         Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}"
                                         Spacing="12"
                                         VerticalOptions="Center">
                        <Label Text="Nutrition Overview"
                               Style="{StaticResource TitleText}" />
                        <Label x:Name="MacroLabel"
                               Style="{StaticResource TelemetryText}"
                               SemanticProperties.Description="Macronutrient summary" />
                        <BoxView HeightRequest="1" />
                        <Label x:Name="DescriptionLabel"
                               Style="{StaticResource BodyText}"
                               SemanticProperties.Description="Food description" />
                        <Label x:Name="AllergyLabel"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource AccentTextL}, Dark={StaticResource AccentB}}"
                               SemanticProperties.Description="Allergy note" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Grid x:Name="ActionPanel"
                  ColumnDefinitions="{OnIdiom Phone='*', Tablet='*,*,*', Desktop='*,*,*'}"
                  RowDefinitions="{OnIdiom Phone='Auto,Auto,Auto', Tablet='Auto', Desktop='Auto'}"
                  ColumnSpacing="12"
                  RowSpacing="10">
                <Button Text="Read summary"
                        Clicked="OnSpeakClicked"
                        SemanticProperties.Description="Read summary"
                        SemanticProperties.Hint="Read the nutrition summary aloud" />
                <Button Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                        Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}"
                        Text="Stop reading"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Surface1L}, Dark={StaticResource Surface2}}"
                        BorderColor="{AppThemeBinding Light={StaticResource HairlineL}, Dark={StaticResource Hairline}}"
                        BorderWidth="1"
                        TextColor="{AppThemeBinding Light={StaticResource AccentTextL}, Dark={StaticResource AccentB}}"
                        Clicked="OnStopSpeechClicked"
                        SemanticProperties.Description="Stop reading"
                        SemanticProperties.Hint="Stop the current speech" />
                <Button Grid.Row="{OnIdiom Phone=2, Tablet=0, Desktop=0}"
                        Grid.Column="{OnIdiom Phone=0, Tablet=2, Desktop=2}"
                        Text="Edit"
                        Clicked="OnEditClicked"
                        SemanticProperties.Description="Edit record"
                        SemanticProperties.Hint="Edit this food or drink record" />
            </Grid>

            <Grid x:Name="RecordActionsPanel"
                  ColumnDefinitions="{OnIdiom Phone='*', Tablet='*,*', Desktop='*,*'}"
                  RowDefinitions="{OnIdiom Phone='Auto,Auto', Tablet='Auto', Desktop='Auto'}"
                  ColumnSpacing="12"
                  RowSpacing="10">
                <Button x:Name="FavoriteButton"
                        Text="Add to favourites"
                        Background="{StaticResource FreshBrush}"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimaryL}, Dark={StaticResource BgBase}}"
                        Clicked="OnFavoriteClicked"
                        SemanticProperties.Description="Add to favourites"
                        SemanticProperties.Hint="Mark this food or drink record as a favourite" />
                <Button x:Name="DeleteButton"
                        Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                        Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}"
                        Text="Delete"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Surface1L}, Dark={StaticResource Surface2}}"
                        BorderColor="{AppThemeBinding Light={StaticResource WarningTextL}, Dark={StaticResource WarningText}}"
                        BorderWidth="1"
                        TextColor="{AppThemeBinding Light={StaticResource WarningTextL}, Dark={StaticResource WarningText}}"
                        Clicked="OnDeleteClicked"
                        SemanticProperties.Description="Delete record"
                        SemanticProperties.Hint="Delete this food or drink record from local SQLite storage" />
            </Grid>

            <Label x:Name="DetailStatusLabel"
                   Text="Ready."
                   FontAttributes="Bold"
                   FontFamily="Mono"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryL}, Dark={StaticResource TextSecondary}}"
                   SemanticProperties.Description="Detail page status" />

            <Button Text="Vibration reminder"
                    Background="{StaticResource FreshBrush}"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimaryL}, Dark={StaticResource BgBase}}"
                    Clicked="OnVibrateClicked"
                    SemanticProperties.Description="Vibration reminder"
                    SemanticProperties.Hint="Use mobile vibration as a meal reminder" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
